# Copia este archivo como ".env" y ajústalo. NO subas el archivo ".env" al repositorio.

# Clave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=django-insecure-cambia-esta-clave-por-una-real

# DEBUG debe ser False en producción.
DJANGO_DEBUG=True

# Hosts permitidos, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Orígenes de confianza para CSRF en producción (con esquema), separados por comas.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://midominio.com,http://mi-ip-publica

# Base de datos del equipo: MySQL 8.4 en Amazon RDS.
#
# El host y el usuario no se cambian. La contraseña la comparte el
# administrador del proyecto; no se sube al repositorio.
#
# La conexión usa TLS con el certificado incluido en certs/global-bundle.pem.
# No desactives la verificación TLS.
#
# El security group de RDS solo permite las IPs públicas del equipo: si tu IP
# cambia (otra red, otro día), la conexión dará timeout aunque el resto del
# .env sea correcto. Comprueba tu IP con: curl -s https://checkip.amazonaws.com
#
# Para usar SQLite en pruebas rápidas sin base de datos, pon
# DJANGO_DB_ENGINE=sqlite y comenta el resto de variables DJANGO_DB_*.
DJANGO_DB_ENGINE=mysql
DJANGO_DB_NAME=indievault
DJANGO_DB_HOST=database-1.cvv8xc2ptzxa.us-east-1.rds.amazonaws.com
DJANGO_DB_PORT=3306
DJANGO_DB_USER=indievault_app
DJANGO_DB_PASSWORD=la-contraseña-que-te-comparta-el-administrador
DJANGO_DB_SSL_CA=certs/global-bundle.pem

# Carpeta de estáticos para producción (Nginx). Por defecto: ./staticfiles
# DJANGO_STATIC_ROOT=/var/www/indievault/staticfiles

# Carpeta de archivos subidos (avatares). Por defecto: ./media
# DJANGO_MEDIA_ROOT=/var/www/indievault/media