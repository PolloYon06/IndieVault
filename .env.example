# Copia este archivo como ".env" y ajústalo. NO subas el archivo ".env" al repositorio.

# Clave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=django-insecure-cambia-esta-clave-por-una-real

# DEBUG debe ser False en producción.
DJANGO_DEBUG=True

# Hosts permitidos, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Orígenes de confianza para CSRF en producción (con esquema), separados por comas.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://midominio.com,http://mi-ip-publica

# Base de datos MySQL/MariaDB. Para AWS RDS, usa el endpoint de la instancia
# como DJANGO_DB_HOST y configura usuario/contraseña en el entorno seguro.
# Para verificar el certificado TLS de RDS, descarga el bundle CA oficial de
# AWS y establece DJANGO_DB_SSL_CA con la ruta local al certificado PEM.
# Para usar SQLite en pruebas rápidas sin levantar MariaDB,
# pon DJANGO_DB_ENGINE=sqlite.
DJANGO_DB_ENGINE=mysql
DJANGO_DB_NAME=indievault
DJANGO_DB_USER=indievault
DJANGO_DB_PASSWORD=indievault
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306
# DJANGO_DB_SSL_CA=/ruta/al/global-bundle.pem

# Carpeta de estáticos para producción (Nginx). Por defecto: ./staticfiles
# DJANGO_STATIC_ROOT=/var/www/indievault/staticfiles