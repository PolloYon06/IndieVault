# Copia este archivo como ".env" y ajústalo. NO subas el archivo ".env" al repositorio.

# Clave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=django-insecure-cambia-esta-clave-por-una-real

# DEBUG debe ser False en producción.
DJANGO_DEBUG=True

# Hosts permitidos, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Base de datos.
# Por defecto se usa MariaDB (Arch, servicio mariadb.service en 127.0.0.1:3306,
# usuario "indievault"). Para usar SQLite en pruebas rápidas sin levantar
# MariaDB, pon DJANGO_DB_ENGINE=sqlite.
DJANGO_DB_ENGINE=mysql
DJANGO_DB_NAME=indievault
DJANGO_DB_USER=indievault
DJANGO_DB_PASSWORD=indievault
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306